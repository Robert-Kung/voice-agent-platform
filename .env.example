LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# ── Admin authentication ─────────────────────────────────────
# ADMIN_PASSWORD: gates the admin UI (Next.js middleware → session cookie).
#   Required in production; without it the admin surface returns 503.
#
# ADMIN_API_TOKEN: gates the FastAPI admin routes (X-Admin-Token header).
#   Generate with:  openssl rand -hex 32
#   The Next.js proxy at /api/admin-proxy/* injects this server-side, so it
#   must NOT be prefixed with NEXT_PUBLIC_ — it should never reach the browser.
#
# ADMIN_API_URL: where the proxy forwards to (FastAPI host).
#   - Local dev (frontend runs on host):    http://localhost:8083
#   - docker-compose (frontend in container): http://api:8083
#                                             (set in docker-compose.yml)
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
ADMIN_API_URL=http://localhost:8083

# ── Try button (admin local dogfooding) ──────────────────────
# Enables /api/test/* — these endpoints spawn agent.py subprocesses on the
# API host. NEVER set in production. Also requires ADMIN_API_TOKEN.
ENABLE_TEST_ROUTES=

# Elevator demo HTTP tool credential (profiles reference it as ${ELEVATOR_API_KEY})
ELEVATOR_API_KEY=
